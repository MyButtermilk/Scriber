{
  "manifest_version": 3,
  "name": "Scriber für YouTube",
  "version": "0.2.1",
  "description": "Startet die Transkription des aktuellen YouTube-Videos direkt in der lokalen Scriber-App.",
  "permissions": ["activeTab"],
  "optional_permissions": ["cookies"],
  "optional_host_permissions": [
    "https://*.youtube.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Mit Scriber transkribieren",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/scriber-16.png",
      "32": "icons/scriber-32.png",
      "48": "icons/scriber-48.png",
      "128": "icons/scriber-128.png"
    }
  },
  "icons": {
    "16": "icons/scriber-16.png",
    "32": "icons/scriber-32.png",
    "48": "icons/scriber-48.png",
    "128": "icons/scriber-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "css": ["content.css"],
      "js": ["shared.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
