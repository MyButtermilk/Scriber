{
  "name": "scriber",
  "version": "0.5.79",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.5.0 <27"
  },
  "scripts": {
    "dev:client": "vite dev --port 5000",
    "dev:tauri": "cargo build --manifest-path src-tauri/Cargo.toml --bin scriber-audio-sidecar && vite dev --port 5000",
    "dev": "vite dev --port 5000",
    "build": "npm run build:webview",
    "build:webview": "vite build",
    "check": "npm run check:app && npm run check:tests",
    "check:app": "tsc -p tsconfig.json",
    "check:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:lib && npm run test:components",
    "test:lib": "tsx --test \"client/src/**/*.test.ts\"",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:i18n": "tsx --test client/src/i18n/i18n.test.ts client/src/lib/meeting-error-message.test.ts client/src/lib/onnx-download-message.test.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:bundle": "tauri bundle"
  },
  "dependencies": {
    "@carrot-kpi/switzer-font": "^0.1.0",
    "@fontsource/inter": "^5.2.8",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@tanstack/react-query": "^5.60.5",
    "@tanstack/react-virtual": "^3.13.26",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.12",
    "lucide-react": "^0.545.0",
    "motion": "^12.42.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2.11.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "30.0.0",
    "postcss": "^8.5.23",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.1.0",
    "vitest": "4.1.10"
  }
}
