{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriber.local/contracts/hf-v2-release-packet-manifest-v1.schema.json",
  "title": "Scriber HF V2 BF16/Q8_0 job packet manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "attempt", "source", "plan", "evaluation_binding", "model", "toolchain", "conversion", "runtime", "output", "inventory", "side_effects"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "scriber_hf_v2_q8_bf16_release_job_packet"},
    "attempt": {"const": "attempt15"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_head", "git_tree", "scope", "dirty_worktree_included"],
      "properties": {
        "git_head": {"$ref": "#/$defs/commit"},
        "git_tree": {"$ref": "#/$defs/commit"},
        "scope": {"const": "complete_tracked_HEAD_tree"},
        "dirty_worktree_included": {"const": false}
      }
    },
    "plan": {"$ref": "#/$defs/file_binding"},
    "evaluation_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "status", "automatic_case_count", "terra_pair_count", "publication_grade"],
      "properties": {
        "path": {"const": "inputs/v2-evaluation-binding.json"},
        "sha256": {"$ref": "#/$defs/hash"},
        "status": {"const": "accepted"},
        "automatic_case_count": {"const": 300},
        "terra_pair_count": {"const": 100},
        "publication_grade": {"const": false}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_uri", "tree_sha256", "run_fingerprint", "weight", "protection_policy_sha256", "postflight_binding_sha256", "mount_path", "copy_into_packet"],
      "properties": {
        "remote_uri": {"const": "hf://buckets/Buttermilk03/scriber-polishing-private-runs/attempt13/scriber-v2-hardcase-replay-v1/training/final-7b23f23e70f60df9"},
        "tree_sha256": {"const": "sha256:4233c0084cacdd3ba88207cece0ce20d1e1f56cfbfa64e71182a2deb2934c743"},
        "run_fingerprint": {"const": "sha256:7b23f23e70f60df9d58961808e529ff7738032de75a7a4a62c12529bc734a45c"},
        "weight": {"const": {"path": "model.safetensors", "bytes": 536223056, "sha256": "sha256:fd86d26f70e128fd1e8d4f11e69d4778ae930e628e374aa64595aca5bd0b9bb3"}},
        "protection_policy_sha256": {"const": "sha256:8872354f8aba8258c688186b03a17df2637ee2f126b388239addc4a540b2c10d"},
        "postflight_binding_sha256": {"const": "sha256:4e9379d8c26cb81d7261b57ab2e0bf5c8059850c07717debc47c0ce99072a8a5"},
        "mount_path": {"const": "/input/model"},
        "copy_into_packet": {"const": false}
      }
    },
    "toolchain": {
      "const": {
        "remote_uri": "hf://buckets/Buttermilk03/scriber-polishing-private-runs/toolchains/llama-cpp-b10156-linux-cuda-v1/v19/final",
        "mount_path": "/input/llama-cpp",
        "lock_path": "/input/llama-cpp/llama-cpp-bundle-lock.json",
        "read_only": true
      }
    },
    "conversion": {"const": {"execution_order": ["BF16", "Q8_0"], "gguf_quantizations": ["Q8_0"], "other_variants_allowed": false, "network_access": "disabled_offline"}},
    "runtime": {"const": {"image": "pytorch/pytorch@sha256:eee11b3b3872a8c838e35ef48f08b2d5def2080902c7f666831310ca1a0ef2be", "flavor": "l4x1", "timeout_minutes": 60}},
    "output": {"const": {"remote_uri": "hf://buckets/Buttermilk03/scriber-polishing-private-runs/attempt15/scriber-v2-q8-bf16-release-v1/quantization", "container_path": "/outputs/quantization", "unique": true, "overwrite_allowed": false}},
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "packet_tree_sha256", "file_count", "byte_count"],
      "properties": {
        "path": {"const": "tree-inventory.json"},
        "sha256": {"$ref": "#/$defs/hash"},
        "packet_tree_sha256": {"$ref": "#/$defs/hash"},
        "file_count": {"type": "integer", "minimum": 7},
        "byte_count": {"type": "integer", "minimum": 1}
      }
    },
    "side_effects": {"const": {"publication_allowed": false, "auto_retry_allowed": false, "secrets_required": []}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "file_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "inputs/v2-release-plan.json"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
