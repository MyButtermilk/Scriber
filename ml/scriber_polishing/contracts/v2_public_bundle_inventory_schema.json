{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriber.local/contracts/v2-public-bundle-inventory-v1.schema.json",
  "title": "Scriber staged V2 public GGUF bundle inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "status",
    "repository_id",
    "visibility",
    "requires_token",
    "plan_sha256",
    "quantization_result_sha256",
    "source_git_head",
    "source_model",
    "variants",
    "evidence_scope",
    "compact_comparison_gate",
    "terra_judge",
    "payload_files",
    "payload_tree_sha256",
    "allowlisted_paths",
    "inventory_path",
    "upload_performed",
    "public_commit"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "scriber_v2_public_bundle_inventory"},
    "status": {"const": "staged"},
    "repository_id": {"const": "Buttermilk03/scriber-gemma3-270m-polishing-de-v2"},
    "visibility": {"const": "public"},
    "requires_token": {"const": false},
    "plan_sha256": {"$ref": "#/$defs/hash"},
    "quantization_result_sha256": {"$ref": "#/$defs/hash"},
    "source_git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_model": {"$ref": "#/$defs/source_model"},
    "variants": {"const": ["Q8_0", "BF16"]},
    "evidence_scope": {"$ref": "#/$defs/evidence_scope"},
    "compact_comparison_gate": {"$ref": "#/$defs/compact_comparison_gate"},
    "terra_judge": {"$ref": "#/$defs/terra_judge"},
    "payload_files": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/license_file"},
        {"$ref": "#/$defs/modifications_file"},
        {"$ref": "#/$defs/notice_file"},
        {"$ref": "#/$defs/readme_file"},
        {"$ref": "#/$defs/bf16_model_file"},
        {"$ref": "#/$defs/bf16_policy_file"},
        {"$ref": "#/$defs/bf16_manifest_file"},
        {"$ref": "#/$defs/q8_model_file"},
        {"$ref": "#/$defs/q8_policy_file"},
        {"$ref": "#/$defs/q8_manifest_file"}
      ],
      "items": false,
      "minItems": 10,
      "maxItems": 10
    },
    "payload_tree_sha256": {"$ref": "#/$defs/hash"},
    "allowlisted_paths": {
      "const": [
        "GEMMA_LICENSE.md",
        "MODIFICATIONS.md",
        "NOTICE",
        "README.md",
        "gguf/bf16/model-BF16.gguf",
        "gguf/bf16/scriber-protection-policy.json",
        "gguf/bf16/variant-artifact-manifest.json",
        "gguf/q8_0/model-Q8_0.gguf",
        "gguf/q8_0/scriber-protection-policy.json",
        "gguf/q8_0/variant-artifact-manifest.json",
        "v2-public-release-inventory.json"
      ]
    },
    "inventory_path": {"const": "v2-public-release-inventory.json"},
    "upload_performed": {"const": false},
    "public_commit": {"type": "null"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "license_file": {
      "allOf": [
        {"$ref": "#/$defs/file"},
        {
          "properties": {
            "path": {"const": "GEMMA_LICENSE.md"},
            "bytes": {"const": 13125},
            "sha256": {"const": "sha256:d7bbbe9ad37291cdef58c411c31e02f21e9afb965c41f18a2d437f0893482624"}
          }
        }
      ]
    },
    "modifications_file": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "MODIFICATIONS.md"}}}]},
    "notice_file": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "NOTICE"}}}]},
    "readme_file": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "README.md"}}}]},
    "bf16_model_file": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "gguf/bf16/model-BF16.gguf"}}}]},
    "bf16_policy_file": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "gguf/bf16/scriber-protection-policy.json"}, "sha256": {"const": "sha256:8872354f8aba8258c688186b03a17df2637ee2f126b388239addc4a540b2c10d"}}}]},
    "bf16_manifest_file": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "gguf/bf16/variant-artifact-manifest.json"}}}]},
    "q8_model_file": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "gguf/q8_0/model-Q8_0.gguf"}}}]},
    "q8_policy_file": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "gguf/q8_0/scriber-protection-policy.json"}, "sha256": {"const": "sha256:8872354f8aba8258c688186b03a17df2637ee2f126b388239addc4a540b2c10d"}}}]},
    "q8_manifest_file": {"allOf": [{"$ref": "#/$defs/file"}, {"properties": {"path": {"const": "gguf/q8_0/variant-artifact-manifest.json"}}}]},
    "source_model": {
      "const": {
        "tree_sha256": "sha256:4233c0084cacdd3ba88207cece0ce20d1e1f56cfbfa64e71182a2deb2934c743",
        "run_fingerprint": "sha256:7b23f23e70f60df9d58961808e529ff7738032de75a7a4a62c12529bc734a45c",
        "weight": {
          "path": "model.safetensors",
          "bytes": 536223056,
          "sha256": "sha256:fd86d26f70e128fd1e8d4f11e69d4778ae930e628e374aa64595aca5bd0b9bb3"
        },
        "protection_policy_sha256": "sha256:8872354f8aba8258c688186b03a17df2637ee2f126b388239addc4a540b2c10d",
        "postflight_binding_sha256": "sha256:4e9379d8c26cb81d7261b57ab2e0bf5c8059850c07717debc47c0ce99072a8a5"
      }
    },
    "evidence_scope": {
      "const": {
        "kind": "compact_smoke_test",
        "publication_grade": false,
        "user_authorized_promotion": true,
        "automatic_case_count": 300,
        "automatic_cases_per_suite": {
          "ai_gold": 100,
          "critical_regression": 100,
          "regular_test": 100
        },
        "blind_judges": {
          "terra_pair_count": 100,
          "sol_pair_count": 0
        }
      }
    },
    "compact_comparison_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_report_suite", "record_count", "coverage", "normalized_exact_match", "deterministic_critical_error_count", "decision", "publication_grade", "requires_terra"],
      "properties": {
        "kind": {"const": "scriber_v2_compact_comparison_gate"},
        "source_report_suite": {"const": "combined"},
        "record_count": {"const": 300},
        "coverage": {"const": {"v1_reused": 300, "v2": 300, "exact": true}},
        "normalized_exact_match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["v1_reused", "v2", "v2_gte_v1"],
          "properties": {
            "v1_reused": {"type": "number", "minimum": 0, "maximum": 1},
            "v2": {"type": "number", "minimum": 0, "maximum": 1},
            "v2_gte_v1": {"const": true}
          }
        },
        "deterministic_critical_error_count": {
          "type": "object",
          "additionalProperties": false,
          "required": ["v1_reused", "v2", "v2_lte_v1"],
          "properties": {
            "v1_reused": {"type": "integer", "minimum": 0},
            "v2": {"type": "integer", "minimum": 0},
            "v2_lte_v1": {"const": true}
          }
        },
        "decision": {"const": "passed"},
        "publication_grade": {"const": false},
        "requires_terra": {"const": true}
      }
    },
    "terra_judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_class", "publication_grade", "aggregate", "verdicts", "judge", "selection", "gate"],
      "properties": {
        "evidence_class": {"const": "compact_smoke_test"},
        "publication_grade": {"const": false},
        "aggregate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256"],
          "properties": {
            "sha256": {"$ref": "#/$defs/hash"}
          }
        },
        "verdicts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sha256", "count"],
          "properties": {
            "sha256": {"$ref": "#/$defs/hash"},
            "count": {"const": 100}
          }
        },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model_family", "session_id", "session_sha256", "prompt_version", "prompt_sha256"],
          "properties": {
            "model_family": {"const": "gpt-5.6-terra"},
            "session_id": {"type": "string", "pattern": "^session_[a-z0-9][a-z0-9_-]{7,127}$"},
            "session_sha256": {"$ref": "#/$defs/hash"},
            "prompt_version": {"const": "v1"},
            "prompt_sha256": {"$ref": "#/$defs/hash"}
          }
        },
        "selection": {
          "const": {
            "source_count": 300,
            "selected_count": 100,
            "quotas": {"ai_gold": 34, "critical_regression": 33, "regular_test": 33}
          }
        },
        "gate": {
          "const": {
            "kind": "compact_promotion",
            "decision": "passed",
            "v2_wins_gte_v1_wins": true,
            "v2_critical_lte_v1_critical": true
          }
        }
      }
    }
  }
}
