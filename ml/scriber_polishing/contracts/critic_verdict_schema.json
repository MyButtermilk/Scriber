{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriber.local/contracts/critic-verdict-v1.schema.json",
  "title": "Scriber blinded AI critic verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "critic_id",
    "critic_role",
    "model_family",
    "reasoning_effort",
    "prompt_hash",
    "reviewed_package_sha256",
    "acceptable",
    "critical_flags",
    "noncritical_flags",
    "confidence",
    "summary_code"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^case_[0-9a-f]{24}$"
    },
    "critic_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{7,79}$"
    },
    "critic_role": {
      "enum": [
        "fact",
        "style",
        "adversarial"
      ]
    },
    "model_family": {
      "enum": [
        "gpt-5.6-terra",
        "gpt-5.6-sol"
      ]
    },
    "reasoning_effort": {
      "enum": [
        "max",
        "ultra"
      ]
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reviewed_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptable": {
      "type": "boolean"
    },
    "critical_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,79}$"
      }
    },
    "noncritical_flags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,79}$"
      }
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "summary_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "acceptable": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "critical_flags": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "critic_role": {
            "enum": [
              "fact",
              "style"
            ]
          }
        },
        "required": [
          "critic_role"
        ]
      },
      "then": {
        "properties": {
          "model_family": {
            "const": "gpt-5.6-terra"
          },
          "reasoning_effort": {
            "const": "max"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "critic_role": {
            "const": "adversarial"
          }
        },
        "required": [
          "critic_role"
        ]
      },
      "then": {
        "properties": {
          "model_family": {
            "const": "gpt-5.6-sol"
          },
          "reasoning_effort": {
            "const": "max"
          }
        }
      }
    }
  ]
}
