{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriber.local/contracts/hub-verification-v6.schema.json",
  "title": "Scriber private Hub verification report v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "namespace",
    "visibility",
    "preflight",
    "completed_training_report_sha256",
    "training_run_fingerprint",
    "bf16_final_model_tree_sha256",
    "protection_policy",
    "selected_checkpoint_publication_sha256",
    "selected_candidate_id",
    "selected_checkpoint_identity_sha256",
    "selected_checkpoint_tree_sha256",
    "selected_model_sha256",
    "selected_config_sha256",
    "base_tokenizer",
    "local_bundle_sha256",
    "publication_binding_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 6
    },
    "status": {
      "const": "verified_private"
    },
    "namespace": {
      "const": "Buttermilk03"
    },
    "visibility": {
      "const": "private"
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "token_role",
        "namespace_authorized",
        "identity_sha256",
        "repository_access_confirmed"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "token_role": {
          "const": "write"
        },
        "namespace_authorized": {
          "const": true
        },
        "identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "repository_access_confirmed": {
          "const": true
        }
      }
    },
    "completed_training_report_sha256": {
      "$ref": "#/$defs/prefixed_sha256"
    },
    "training_run_fingerprint": {
      "$ref": "#/$defs/prefixed_sha256"
    },
    "bf16_final_model_tree_sha256": {
      "$ref": "#/$defs/prefixed_sha256"
    },
    "protection_policy": {
      "$ref": "#/$defs/protection_policy"
    },
    "selected_checkpoint_publication_sha256": {
      "$ref": "#/$defs/prefixed_sha256"
    },
    "selected_candidate_id": {
      "type": "string",
      "pattern": "^checkpoint-[1-9][0-9]*$"
    },
    "selected_checkpoint_identity_sha256": {
      "$ref": "#/$defs/prefixed_sha256"
    },
    "selected_checkpoint_tree_sha256": {
      "$ref": "#/$defs/prefixed_sha256"
    },
    "selected_model_sha256": {
      "$ref": "#/$defs/prefixed_sha256"
    },
    "selected_config_sha256": {
      "$ref": "#/$defs/prefixed_sha256"
    },
    "base_tokenizer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision"
      ],
      "properties": {
        "id": {
          "const": "google/gemma-3-270m-it"
        },
        "revision": {
          "const": "ac82b4e820549b854eebf28ce6dedaf9fdfa17b3"
        }
      }
    },
    "local_bundle_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "publication_binding_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "dataset"
      ],
      "properties": {
        "model": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "repo_type": {
                  "const": "model"
                },
                "reload": {
                  "$ref": "#/$defs/model_reload"
                }
              }
            }
          ]
        },
        "dataset": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "required": [
                "expected_split_counts",
                "expected_split_inventory"
              ],
              "properties": {
                "repo_type": {
                  "const": "dataset"
                },
                "reload": {
                  "$ref": "#/$defs/dataset_reload"
                }
              }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prefixed_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "remote_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "expected_sha256",
        "hub_hash_kind",
        "hub_hash",
        "remote_size_verified",
        "remote_identity_verified",
        "source_sha256_verified"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "expected_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "hub_hash_kind": {
          "enum": [
            "hub_lfs_sha256",
            "git_blob_sha1"
          ]
        },
        "hub_hash": {
          "type": "string",
          "minLength": 1
        },
        "remote_size_verified": {
          "const": true
        },
        "remote_identity_verified": {
          "const": true
        },
        "source_sha256_verified": {
          "const": true
        }
      }
    },
    "reload": {
      "type": "object",
      "required": [
        "status",
        "execution_isolation",
        "fresh_cache",
        "network_disabled",
        "credentials_removed",
        "legal_files",
        "checksums"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "execution_isolation": {
          "enum": [
            "fresh_python_isolated",
            "in_process_test_override"
          ]
        },
        "fresh_cache": {
          "const": true
        },
        "network_disabled": {
          "const": true
        },
        "credentials_removed": {
          "const": true
        },
        "legal_files": {
          "$ref": "#/$defs/legal_files"
        },
        "checksums": {
          "$ref": "#/$defs/checksums"
        }
      }
    },
    "model_reload": {
      "allOf": [
        {
          "$ref": "#/$defs/reload"
        },
        {
          "required": [
            "protection_policy",
            "variant_release",
            "runtime_reload",
            "regression"
          ],
          "properties": {
            "protection_policy": {
              "$ref": "#/$defs/protection_policy"
            },
            "variant_release": {
              "$ref": "#/$defs/variant_release"
            },
            "runtime_reload": {
              "$ref": "#/$defs/runtime_reload"
            },
            "regression": {
              "$ref": "#/$defs/regression"
            }
          }
        }
      ]
    },
    "dataset_reload": {
      "allOf": [
        {
          "$ref": "#/$defs/reload"
        },
        {
          "required": [
            "split_counts",
            "split_inventory",
            "ai_gold_split_counts",
            "ai_gold_split_inventory"
          ],
          "properties": {
            "split_counts": {
              "$ref": "#/$defs/split_counts"
            },
            "split_inventory": {
              "$ref": "#/$defs/split_inventory"
            },
            "ai_gold_split_counts": {
              "$ref": "#/$defs/split_counts"
            },
            "ai_gold_split_inventory": {
              "$ref": "#/$defs/split_inventory"
            }
          }
        }
      ]
    },
    "legal_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "kind",
        "files"
      ],
      "properties": {
        "status": {
          "const": "verified"
        },
        "kind": {
          "enum": [
            "gemma_derived_model",
            "synthetic_dataset"
          ]
        },
        "files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "checksums": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "manifest_sha256",
        "payload_tree_sha256",
        "file_count"
      ],
      "properties": {
        "status": {
          "const": "verified"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "variant_release": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "passed": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "matrix_status": {
                "const": "RELEASE_MATRIX_PASSED"
              },
              "variants": {
                "const": [
                  "bf16",
                  "int8",
                  "int4_nf4",
                  "Q8_0",
                  "Q4_K_M"
                ]
              },
              "ineligible_variants": {
                "maxProperties": 0
              },
              "qualification_failures": {
                "maxProperties": 0
              },
              "reasons": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "matrix_status": {
                "const": "PRIVATE_CANDIDATE_MATRIX"
              },
              "reasons": {
                "minItems": 1
              }
            },
            "anyOf": [
              {
                "properties": {
                  "ineligible_variants": {
                    "minProperties": 1
                  }
                }
              },
              {
                "properties": {
                  "qualification_failures": {
                    "minProperties": 1
                  }
                }
              }
            ]
          }
        }
      ],
      "required": [
        "status",
        "matrix_status",
        "passed",
        "report_sha256",
        "training_fingerprint",
        "tested_variants",
        "variants",
        "ineligible_variants",
        "qualification_failures",
        "reasons",
        "fresh_reload_report_sha256"
      ],
      "properties": {
        "status": {
          "const": "verified"
        },
        "matrix_status": {
          "enum": [
            "RELEASE_MATRIX_PASSED",
            "PRIVATE_CANDIDATE_MATRIX"
          ]
        },
        "passed": {
          "type": "boolean"
        },
        "report_sha256": {
          "$ref": "#/$defs/prefixed_sha256"
        },
        "training_fingerprint": {
          "$ref": "#/$defs/prefixed_sha256"
        },
        "tested_variants": {
          "const": [
            "bf16",
            "int8",
            "int4_nf4",
            "Q8_0",
            "Q4_K_M"
          ]
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "bf16",
              "int8",
              "int4_nf4",
              "Q8_0",
              "Q4_K_M"
            ]
          }
        },
        "ineligible_variants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bf16": {
              "$ref": "#/$defs/variant_failure"
            },
            "int8": {
              "$ref": "#/$defs/variant_failure"
            },
            "int4_nf4": {
              "$ref": "#/$defs/variant_failure"
            },
            "Q8_0": {
              "$ref": "#/$defs/variant_failure"
            },
            "Q4_K_M": {
              "$ref": "#/$defs/variant_failure"
            }
          }
        },
        "qualification_failures": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bf16": {
              "$ref": "#/$defs/variant_qualification_failure"
            },
            "int8": {
              "$ref": "#/$defs/variant_qualification_failure"
            },
            "int4_nf4": {
              "$ref": "#/$defs/variant_qualification_failure"
            },
            "Q8_0": {
              "$ref": "#/$defs/variant_qualification_failure"
            },
            "Q4_K_M": {
              "$ref": "#/$defs/variant_qualification_failure"
            }
          }
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]+$"
          }
        },
        "fresh_reload_report_sha256": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "bf16": {
              "$ref": "#/$defs/prefixed_sha256"
            },
            "int8": {
              "$ref": "#/$defs/prefixed_sha256"
            },
            "int4_nf4": {
              "$ref": "#/$defs/prefixed_sha256"
            },
            "Q8_0": {
              "$ref": "#/$defs/prefixed_sha256"
            },
            "Q4_K_M": {
              "$ref": "#/$defs/prefixed_sha256"
            }
          }
        }
      }
    },
    "variant_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "reason_code",
        "evidence_sha256"
      ],
      "properties": {
        "stage": {
          "enum": [
            "artifact",
            "reload",
            "predictions",
            "evaluation",
            "delta",
            "benchmark"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/prefixed_sha256"
        }
      }
    },
    "variant_qualification_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "reason_code",
        "evidence_sha256"
      ],
      "properties": {
        "stage": {
          "enum": [
            "evaluation",
            "delta"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/prefixed_sha256"
        }
      }
    },
    "runtime_reload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "source_equivalence",
        "files"
      ],
      "properties": {
        "status": {
          "const": "verified"
        },
        "source_equivalence": {
          "const": "artifact_bytes_equal_executed_package"
        },
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "enum": [
                  "runtime/inference.py",
                  "runtime/sst_parser.py",
                  "runtime/renderers.py",
                  "sst_v1_schema.json"
                ]
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "file",
        "cases_sha256",
        "case_count",
        "minimum_case_count",
        "category_counts",
        "source_partition_counts",
        "required_categories",
        "ai_gold_smoke_count",
        "ai_gold_smoke_minimum",
        "private_data",
        "holdout_data",
        "exact_output_hash_matches",
        "protected_span_checks",
        "sst_round_trip_checks",
        "renderer_checks",
        "latency_ms"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "file": {
          "const": "examples/regression_sample.jsonl"
        },
        "cases_sha256": {
          "$ref": "#/$defs/prefixed_sha256"
        },
        "case_count": {
          "type": "integer",
          "minimum": 100
        },
        "minimum_case_count": {
          "type": "integer",
          "minimum": 100
        },
        "category_counts": {
          "type": "object",
          "minProperties": 10,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "source_partition_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "synthetic_non_holdout"
          ],
          "minProperties": 2,
          "properties": {
            "synthetic_non_holdout": {
              "type": "integer",
              "minimum": 1
            },
            "ai_gold_train": {
              "type": "integer",
              "minimum": 1
            },
            "ai_gold_validation": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "required_categories": {
          "type": "array",
          "minItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ai_gold_smoke_count": {
          "type": "integer",
          "minimum": 1
        },
        "ai_gold_smoke_minimum": {
          "type": "integer",
          "minimum": 1
        },
        "private_data": {
          "const": false
        },
        "holdout_data": {
          "const": false
        },
        "exact_output_hash_matches": {
          "type": "integer",
          "minimum": 100
        },
        "protected_span_checks": {
          "type": "integer",
          "minimum": 100
        },
        "sst_round_trip_checks": {
          "type": "integer",
          "minimum": 100
        },
        "renderer_checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sst",
            "plain_text",
            "markdown",
            "html",
            "html_clipboard"
          ],
          "properties": {
            "sst": {
              "type": "integer",
              "minimum": 100
            },
            "plain_text": {
              "type": "integer",
              "minimum": 100
            },
            "markdown": {
              "type": "integer",
              "minimum": 100
            },
            "html": {
              "type": "integer",
              "minimum": 100
            },
            "html_clipboard": {
              "type": "integer",
              "minimum": 100
            }
          }
        },
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sample_count",
            "p50",
            "p95",
            "p99",
            "maximum"
          ],
          "properties": {
            "sample_count": {
              "type": "integer",
              "minimum": 100
            },
            "p50": {
              "type": "number",
              "minimum": 0
            },
            "p95": {
              "type": "number",
              "minimum": 0
            },
            "p99": {
              "type": "number",
              "minimum": 0
            },
            "maximum": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "protection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "artifact_sha256",
        "policy_id",
        "policy_sha256",
        "tokenizer_identity_sha256"
      ],
      "properties": {
        "filename": {
          "const": "scriber-protection-policy.json"
        },
        "artifact_sha256": {
          "const": "sha256:8872354f8aba8258c688186b03a17df2637ee2f126b388239addc4a540b2c10d"
        },
        "policy_id": {
          "const": "gemma_lexical_v1"
        },
        "policy_sha256": {
          "const": "sha256:9f10947282aad273fbc0af8f08f0c2bd9444eb6a8d10a54d9274fa0eebd133ce"
        },
        "tokenizer_identity_sha256": {
          "const": "sha256:f2fd01c3ec43ff4adb6f920a5466cbdba96801901b4fa778a029af561f499f20"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_mode": {
                "const": "fresh_exact_revision_download"
              }
            }
          },
          "then": {
            "properties": {
              "exact_revision_downloaded": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "exact_revision_downloaded": {
                "const": false
              }
            }
          }
        }
      ],
      "required": [
        "repo_id",
        "repo_type",
        "revision",
        "manifest_sha256",
        "payload_tree_sha256",
        "upload_tree_sha256",
        "uploaded_file_count",
        "remote_files",
        "verification_mode",
        "exact_revision_downloaded",
        "source_snapshot_verified",
        "remote_identity_verified",
        "reload"
      ],
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 3
        },
        "repo_type": {
          "enum": [
            "model",
            "dataset"
          ]
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "payload_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "upload_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "uploaded_file_count": {
          "type": "integer",
          "minimum": 1
        },
        "remote_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/remote_file"
          }
        },
        "verification_mode": {
          "enum": [
            "fresh_exact_revision_download",
            "local_source_remote_identity"
          ]
        },
        "exact_revision_downloaded": {
          "type": "boolean"
        },
        "source_snapshot_verified": {
          "const": true
        },
        "remote_identity_verified": {
          "const": true
        },
        "expected_split_counts": {
          "$ref": "#/$defs/split_count_groups"
        },
        "expected_split_inventory": {
          "$ref": "#/$defs/split_inventory_groups"
        },
        "reload": {
          "$ref": "#/$defs/reload"
        }
      }
    },
    "split_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train",
        "validation",
        "test",
        "challenge"
      ],
      "properties": {
        "train": {
          "type": "integer",
          "minimum": 1
        },
        "validation": {
          "type": "integer",
          "minimum": 1
        },
        "test": {
          "type": "integer",
          "minimum": 1
        },
        "challenge": {
