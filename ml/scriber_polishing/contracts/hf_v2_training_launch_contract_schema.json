  "required": ["schema_version", "kind", "attempt", "source_git_head", "image", "flavor", "timeout", "job_name", "packet_remote_uri", "parent_remote_uri", "output_mount_uri", "remote_result_uri", "packet_volume", "parent_volume", "output_volume", "packet_tree_sha256", "manifest_sha256", "inventory_sha256", "launch_claim_placeholder", "remote_packet_exact_inventory_required", "remote_output_absence_required", "active_job_snapshots_required", "external_job_started", "auto_retry_allowed", "secret_names", "argv"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "scriber_hf_v2_training_launch_contract"},
    "attempt": {"const": "attempt13"},
    "source_git_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "image": {"const": "pytorch/pytorch@sha256:eee11b3b3872a8c838e35ef48f08b2d5def2080902c7f666831310ca1a0ef2be"},
    "flavor": {"const": "l4x1"},
    "timeout": {"const": "240m"},
    "job_name": {"const": "scriber-v2-hardcase-replay-v1"},
    "packet_remote_uri": {"const": "hf://buckets/Buttermilk03/scriber-polishing-private-runs/attempt13/packets/scriber-v2-hardcase-replay-v1"},
    "parent_remote_uri": {"const": "hf://buckets/Buttermilk03/scriber-polishing-private-runs/attempt11/scriber-full-120k-v2/training/final-84458762af7b00ac"},
    "output_mount_uri": {"const": "hf://buckets/Buttermilk03/scriber-polishing-private-runs/attempt13"},
    "remote_result_uri": {"const": "hf://buckets/Buttermilk03/scriber-polishing-private-runs/attempt13/scriber-v2-hardcase-replay-v1"},
    "packet_volume": {"type": "string"},
    "parent_volume": {"type": "string"},
    "output_volume": {"type": "string"},
    "packet_tree_sha256": {"$ref": "#/$defs/hash"},
    "manifest_sha256": {"$ref": "#/$defs/hash"},
    "inventory_sha256": {"$ref": "#/$defs/hash"},
    "launch_claim_placeholder": {"const": "__SCRIBER_V2_LAUNCH_CLAIM_OWNER__"},
    "remote_packet_exact_inventory_required": {"const": true},
    "remote_output_absence_required": {"const": true},
    "active_job_snapshots_required": {"const": 3},
    "external_job_started": {"const": false},
    "auto_retry_allowed": {"const": false},
    "secret_names": {"type": "array", "maxItems": 0},
    "argv": {"type": "array", "minItems": 20, "items": {"type": "string"}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
