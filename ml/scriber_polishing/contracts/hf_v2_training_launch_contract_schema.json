{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriber.local/contracts/hf-v2-training-launch-contract-v1.schema.json",
  "title": "Scriber HF V2 single-shot launch contract v1",
  "type": "object",
