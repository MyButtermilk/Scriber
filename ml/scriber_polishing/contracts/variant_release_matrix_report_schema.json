{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriber.local/contracts/variant-release-matrix-report-v4.schema.json",
  "title": "Scriber local variant qualification matrix report v4",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "passed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "RELEASE_MATRIX_PASSED"
          },
          "variants": {
            "const": [
              "bf16",
              "int8",
              "int4_nf4",
              "Q8_0",
              "Q4_K_M"
            ]
          },
          "ineligible_variants": {
            "maxProperties": 0
          },
          "qualification_failures": {
            "maxProperties": 0
          },
          "reasons": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "const": "PRIVATE_CANDIDATE_MATRIX"
          },
          "reasons": {
            "minItems": 1
          }
        },
        "anyOf": [
          {
            "properties": {
              "ineligible_variants": {
                "minProperties": 1
              }
            }
          },
          {
            "properties": {
              "qualification_failures": {
                "minProperties": 1
              }
            }
          }
        ]
      }
    }
  ],
  "required": [
    "schema_version",
    "status",
    "passed",
    "baseline_variant",
    "training_fingerprint",
    "protection_policy",
    "tested_variants",
    "variants",
    "variant_summaries",
    "ineligible_variants",
    "qualification_failures",
    "reasons"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "status": {
      "enum": [
        "RELEASE_MATRIX_PASSED",
        "PRIVATE_CANDIDATE_MATRIX"
      ]
    },
    "passed": {
      "type": "boolean"
    },
    "baseline_variant": {
      "const": "bf16"
    },
    "training_fingerprint": {
      "$ref": "#/$defs/hash"
    },
    "protection_policy": {
      "$ref": "#/$defs/protection_policy"
    },
    "tested_variants": {
      "const": [
        "bf16",
        "int8",
        "int4_nf4",
        "Q8_0",
        "Q4_K_M"
      ]
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "bf16",
          "int8",
          "int4_nf4",
          "Q8_0",
          "Q4_K_M"
        ]
      }
    },
    "variant_summaries": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "bf16": {
          "$ref": "#/$defs/summary"
        },
        "int8": {
          "$ref": "#/$defs/summary"
        },
        "int4_nf4": {
          "$ref": "#/$defs/summary"
        },
        "Q8_0": {
          "$ref": "#/$defs/summary"
        },
        "Q4_K_M": {
          "$ref": "#/$defs/summary"
        }
      }
    },
    "ineligible_variants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bf16": {
          "$ref": "#/$defs/failure"
        },
        "int8": {
          "$ref": "#/$defs/failure"
        },
        "int4_nf4": {
          "$ref": "#/$defs/failure"
        },
        "Q8_0": {
          "$ref": "#/$defs/failure"
        },
        "Q4_K_M": {
          "$ref": "#/$defs/failure"
        }
      }
    },
    "qualification_failures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bf16": {
          "$ref": "#/$defs/qualificationFailure"
        },
        "int8": {
          "$ref": "#/$defs/qualificationFailure"
        },
        "int4_nf4": {
          "$ref": "#/$defs/qualificationFailure"
        },
        "Q8_0": {
          "$ref": "#/$defs/qualificationFailure"
        },
        "Q4_K_M": {
          "$ref": "#/$defs/qualificationFailure"
        }
      }
    },
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "protection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "artifact_sha256",
        "policy_id",
        "policy_sha256",
        "tokenizer_identity_sha256"
      ],
      "properties": {
        "filename": {
          "const": "scriber-protection-policy.json"
        },
        "artifact_sha256": {
          "const": "sha256:8872354f8aba8258c688186b03a17df2637ee2f126b388239addc4a540b2c10d"
        },
        "policy_id": {
          "const": "gemma_lexical_v1"
        },
        "policy_sha256": {
          "const": "sha256:9f10947282aad273fbc0af8f08f0c2bd9444eb6a8d10a54d9274fa0eebd133ce"
        },
        "tokenizer_identity_sha256": {
          "const": "sha256:f2fd01c3ec43ff4adb6f920a5466cbdba96801901b4fa778a029af561f499f20"
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "reason_code",
        "evidence_sha256"
      ],
      "properties": {
        "stage": {
          "enum": [
            "artifact",
            "reload",
            "predictions",
            "evaluation",
            "delta",
            "benchmark"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "qualificationFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "reason_code",
        "evidence_sha256"
      ],
      "properties": {
        "stage": {
          "enum": [
            "evaluation",
            "delta"
          ]
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_tree_sha256",
        "artifact_manifest_sha256",
        "reload_report_sha256",
        "predictions_sha256",
        "evaluation_report_sha256",
        "delta_report_sha256",
        "benchmark_report_sha256",
        "prediction_count",
        "maximum_absolute_metric_drop",
        "new_critical_errors",
        "persistent_warm_runtime",
        "evidence"
      ],
      "properties": {
        "artifact_tree_sha256": {
          "$ref": "#/$defs/hash"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/hash"
        },
        "reload_report_sha256": {
          "$ref": "#/$defs/hash"
        },
        "predictions_sha256": {
          "$ref": "#/$defs/hash"
        },
        "evaluation_report_sha256": {
          "$ref": "#/$defs/hash"
        },
        "delta_report_sha256": {
          "$ref": "#/$defs/hash"
        },
        "benchmark_report_sha256": {
          "$ref": "#/$defs/hash"
        },
        "prediction_count": {
          "type": "integer",
          "minimum": 1
        },
        "maximum_absolute_metric_drop": {
          "type": "number",
          "minimum": 0
        },
        "new_critical_errors": {
          "type": "integer",
          "minimum": 0
        },
        "persistent_warm_runtime": {
          "const": true
        },
        "evidence": {
          "type": "array",
          "const": [
            "artifact",
            "reload",
            "predictions",
            "evaluation",
            "delta",
            "benchmark"
          ]
        }
      }
    }
  }
}
