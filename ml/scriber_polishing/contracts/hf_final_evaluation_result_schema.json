        "prediction_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "prediction_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evaluation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "evaluation_exit": {
          "enum": [
            0,
            2
          ]
        },
        "gate_status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "gate_passed": {
          "type": "boolean"
        }
      }
    }
  }
}
