{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriber.local/contracts/remediation-order-plan-v1.schema.json",
  "title": "Scriber remediation A/B order plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "mode",
    "algorithm",
    "phase_rules_version",
    "seed",
    "epochs",
    "comparison_pair_sha256",
    "source",
    "safety_source",
    "protection_policy",
    "parent_checkpoint",
    "safety_filter",
    "training_contract",
    "phase_counts",
    "assignments",
    "epoch_orders",
    "state_initialization",
    "holdout_inputs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "scriber_remediation_order_plan"
    },
    "mode": {
      "enum": [
        "shuffled",
        "staged"
      ]
    },
    "algorithm": {
      "const": "matched_remediation_seeded_sha256_v1"
    },
    "phase_rules_version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "epochs": {
      "const": 1
    },
    "comparison_pair_sha256": {
      "$ref": "#/$defs/rawSha256"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "record_count",
        "split",
        "selected_safe_example_ids_sha256"
      ],
      "properties": {
        "filename": {
          "$ref": "#/$defs/basename"
        },
        "sha256": {
          "$ref": "#/$defs/rawSha256"
        },
        "record_count": {
          "type": "integer",
          "minimum": 5
        },
        "split": {
          "const": "train"
        },
        "selected_safe_example_ids_sha256": {
          "$ref": "#/$defs/rawSha256"
        }
      }
    },
    "safety_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256",
        "record_count",
        "split"
      ],
      "properties": {
        "filename": {
          "$ref": "#/$defs/basename"
        },
        "sha256": {
          "$ref": "#/$defs/rawSha256"
        },
        "record_count": {
          "type": "integer",
          "minimum": 5
        },
        "split": {
          "const": "train"
        }
      }
    },
    "protection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "policy_sha256",
        "artifact_sha256"
      ],
      "properties": {
        "policy_id": {
          "enum": [
            "gemma_unused_v1",
            "gemma_lexical_v1"
          ]
        },
        "policy_sha256": {
          "$ref": "#/$defs/prefixedSha256"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/rawSha256"
        }
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "policy_id",
        "policy_sha256",
        "artifact_sha256"
      ],
      "properties": {
        "filename": {
          "$ref": "#/$defs/basename"
        },
        "policy_id": {
          "const": "gemma_unused_v1"
        },
        "policy_sha256": {
          "$ref": "#/$defs/prefixedSha256"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/rawSha256"
        }
      }
    },
    "parent_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "training_report_sha256",
        "tree_sha256",
        "relationship"
      ],
      "properties": {
        "candidate_id": {
          "$ref": "#/$defs/identifier"
        },
        "training_report_sha256": {
          "$ref": "#/$defs/prefixedSha256"
        },
        "tree_sha256": {
          "$ref": "#/$defs/prefixedSha256"
        },
        "relationship": {
          "const": "warm_start_parent_not_resume"
        }
      }
    },
    "safety_filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loaded_record_count",
        "accepted_record_count",
        "rejected_record_count",
        "rejected_example_ids_sha256",
        "url_overlap_rejected_example_ids",
        "url_overlap_rejected_example_ids_sha256"
      ],
      "properties": {
        "loaded_record_count": {
          "type": "integer",
          "minimum": 1
        },
        "accepted_record_count": {
          "type": "integer",
          "minimum": 1
        },
        "rejected_record_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_example_ids_sha256": {
          "$ref": "#/$defs/rawSha256"
        },
        "url_overlap_rejected_example_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "url_overlap_rejected_example_ids_sha256": {
          "$ref": "#/$defs/rawSha256"
        }
      }
    },
    "training_contract": {
      "$ref": "#/$defs/trainingContract"
    },
    "phase_counts": {
      "$ref": "#/$defs/phaseCounts"
    },
    "assignments": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "example_id",
          "phase"
        ],
        "properties": {
          "example_id": {
            "$ref": "#/$defs/identifier"
          },
          "phase": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    },
    "epoch_orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "epoch",
          "example_ids",
          "example_ids_sha256"
        ],
        "properties": {
          "epoch": {
            "const": 0
          },
          "example_ids": {
            "type": "array",
            "minItems": 5,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "example_ids_sha256": {
            "$ref": "#/$defs/rawSha256"
          }
        }
      }
    },
    "effective_order_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "source_order_plan",
        "source_training_report",
        "example_ids",
        "example_ids_sha256"
      ],
      "properties": {
        "algorithm": {
          "const": "frozen_source_effective_order_v1"
        },
        "source_order_plan": {
          "$ref": "#/$defs/fileBinding"
        },
        "source_training_report": {
          "$ref": "#/$defs/fileBinding"
        },
        "example_ids": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "example_ids_sha256": {
          "$ref": "#/$defs/rawSha256"
        }
      }
    },
    "state_initialization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optimizer",
        "scheduler",
        "parent_as_resume",
        "same_run_resume"
      ],
      "properties": {
        "optimizer": {
          "const": "fresh"
        },
        "scheduler": {
          "const": "fresh"
        },
        "parent_as_resume": {
          "const": "forbidden"
        },
        "same_run_resume": {
          "const": "identity_bound_recovery_only"
        }
      }
    },
    "holdout_inputs": {
      "const": false
    }
  },
  "$defs": {
    "rawSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prefixedSha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,299}$"
    },
    "basename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\]+$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "sha256"
      ],
      "properties": {
        "filename": {
          "$ref": "#/$defs/basename"
        },
        "sha256": {
          "$ref": "#/$defs/rawSha256"
        }
      }
    },
    "phaseCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "properties": {
        "1": {
          "type": "integer",
          "minimum": 1
        },
        "2": {
          "type": "integer",
          "minimum": 1
        },
        "3": {
          "type": "integer",
          "minimum": 1
        },
        "4": {
          "type": "integer",
          "minimum": 1
        },
        "5": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "trainingContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_sequence_length",
        "micro_batch_size",
        "gradient_accumulation_steps",
        "effective_batch_size",
        "learning_rate",
        "optimizer",
        "scheduler",
        "eval_steps",
        "save_steps",
        "save_total_limit",
        "warmup_ratio",
        "weight_decay",
        "max_grad_norm",
        "bf16",
        "gradient_checkpointing",
        "assistant_output_loss_only",
        "early_stopping"
      ],
      "properties": {
        "max_sequence_length": {
          "type": "integer",
          "minimum": 128,
          "maximum": 4096
        },
        "micro_batch_size": {
          "enum": [
            1,
            2,
            4
          ]
        },
        "gradient_accumulation_steps": {
          "type": "integer",
          "minimum": 1
        },
        "effective_batch_size": {
          "const": 16
        },
        "learning_rate": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.01
        },
        "optimizer": {
          "const": "adamw_torch_fused"
        },
        "scheduler": {
          "const": "linear"
        },
        "eval_steps": {
          "type": "integer",
          "minimum": 1
        },
        "save_steps": {
          "type": "integer",
          "minimum": 1
        },
        "save_total_limit": {
          "type": "integer",
          "minimum": 1
        },
        "warmup_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "weight_decay": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_grad_norm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bf16": {
          "const": true
        },
        "gradient_checkpointing": {
          "type": "boolean"
        },
        "assistant_output_loss_only": {
          "const": true
        },
        "early_stopping": {
          "const": false
        }
      }
    }
  }
}
