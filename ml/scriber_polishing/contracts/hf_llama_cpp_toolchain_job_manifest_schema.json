{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriber.local/contracts/hf-llama-cpp-toolchain-job-manifest-v1.schema.json",
  "title": "Scriber Hugging Face llama.cpp b10156 toolchain job manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "attempt",
    "source_git_head",
    "image",
    "flavor",
    "timeout_minutes",
    "source",
    "oci",
    "build",
    "dependencies",
    "cost_guard",
    "output",
    "side_effects",
    "runner_sha256",
    "packet_tree_sha256",
    "file_count",
    "byte_count"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "scriber_hf_llama_cpp_toolchain_job"
    },
    "attempt": {
      "const": "v19"
    },
    "source_git_head": {
      "const": "7ecd7e1ed349d1bcadbbb8151b584b766e9746d5"
    },
    "image": {
      "const": "pytorch/pytorch@sha256:eee11b3b3872a8c838e35ef48f08b2d5def2080902c7f666831310ca1a0ef2be"
    },
    "flavor": {
      "const": "cpu-basic"
    },
    "timeout_minutes": {
      "const": 20
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit",
        "version",
        "checkout_inventory",
        "source_inventory"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/ggml-org/llama.cpp"
        },
        "commit": {
          "const": "91f8c9c5fb038c086e13e9cd823c29b33b07ba54"
        },
        "version": {
          "const": "b10156"
        },
        "checkout_inventory": {
          "$ref": "#/$defs/tree_inventory"
        },
        "source_inventory": {
          "$ref": "#/$defs/source_inventory"
        }
      }
    },
    "oci": {
      "$ref": "#/$defs/oci"
    },
    "build": {
      "$ref": "#/$defs/build"
    },
    "dependencies": {
      "$ref": "#/$defs/dependencies"
    },
    "cost_guard": {
      "$ref": "#/$defs/cost_guard"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bucket_root",
        "mount_uri",
        "mount_container_path",
        "relative_path",
        "container_path",
        "staging_container_path",
        "remote_uri",
        "unique",
        "overwrite_allowed",
        "publication_protocol"
      ],
      "properties": {
        "bucket_root": {
          "const": "hf://buckets/Buttermilk03/scriber-polishing-private-runs"
        },
        "mount_uri": {
          "const": "hf://buckets/Buttermilk03/scriber-polishing-private-runs/toolchains/llama-cpp-b10156-linux-cuda-v1/v19"
        },
        "mount_container_path": {
          "const": "/outputs"
        },
        "relative_path": {
          "const": "toolchains/llama-cpp-b10156-linux-cuda-v1/v19/final"
        },
        "container_path": {
          "const": "/outputs/final"
        },
        "staging_container_path": {
          "const": "/outputs/.staging"
        },
        "remote_uri": {
          "const": "hf://buckets/Buttermilk03/scriber-polishing-private-runs/toolchains/llama-cpp-b10156-linux-cuda-v1/v19/final"
        },
        "unique": {
          "const": true
        },
        "overwrite_allowed": {
          "const": false
        },
        "publication_protocol": {
          "const": "owner_token_stage_rename_noreplace_v1"
        }
      }
    },
    "side_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_steps_executed",
        "evaluation_reports_written",
        "prediction_records_written",
        "publication_allowed",
        "secrets_required"
      ],
      "properties": {
        "training_steps_executed": {
          "const": 0
        },
        "evaluation_reports_written": {
          "const": 0
        },
        "prediction_records_written": {
          "const": 0
        },
        "publication_allowed": {
          "const": false
        },
        "secrets_required": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "runner_sha256": {
      "$ref": "#/$defs/hash"
    },
    "packet_tree_sha256": {
      "$ref": "#/$defs/hash"
    },
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "byte_count": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "usd": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{3,6}$"
    },
    "tree_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "tree_sha256",
        "entry_count",
        "total_file_bytes"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256-canonical-path-kind-size-content-or-target-v1"
        },
        "tree_sha256": {
          "$ref": "#/$defs/hash"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_file_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "tree_sha256",
        "file_count",
        "total_bytes"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256-path-size-content-v1"
        },
        "tree_sha256": {
          "$ref": "#/$defs/hash"
        },
        "file_count": {
          "type": "integer",
          "minimum": 1
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "oci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "index_digest",
        "manifest_digest",
        "config_digest",
        "revision",
        "platform",
        "layers"
      ],
      "properties": {
        "repository": {
          "const": "ghcr.io/ggml-org/llama.cpp"
        },
        "tag": {
          "const": "full-cuda12-b10156"
        },
        "index_digest": {
          "const": "sha256:edbbe95d1f20b1b0451dcf61f33be9547dd43578a8ca3456b4127d03a99ce2f7"
        },
        "manifest_digest": {
          "const": "sha256:b039c93fa0f667af80ca61006a6cbaba1aef1928c88644ad3613471a71952d10"
        },
        "config_digest": {
          "const": "sha256:91b633bbe9948c02ed0c838aaf8f16dd90472c1dddd2d972b4bdbfda6a993bfb"
        },
        "revision": {
          "const": "91f8c9c5fb038c086e13e9cd823c29b33b07ba54"
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "os",
            "architecture"
          ],
          "properties": {
            "os": {
              "const": "linux"
            },
            "architecture": {
              "const": "amd64"
            }
          }
        },
        "layers": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/native_layer"
            },
            {
              "$ref": "#/$defs/tools_layer"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "native_layer": {
      "allOf": [
        {
          "$ref": "#/$defs/layer"
        },
        {
          "properties": {
            "digest": {
              "const": "sha256:6cbda075c071eae617924009643fa4cf584ebbfd6f9308225264303b29dd14bd"
            },
            "compressed_bytes": {
              "const": 162560439
            },
            "purpose": {
              "const": "native_libraries"
            },
            "packet_filename": {
              "const": "6cbda075c071eae617924009643fa4cf584ebbfd6f9308225264303b29dd14bd.tar.gz"
            }
          }
        }
      ]
    },
    "tools_layer": {
      "allOf": [
        {
          "$ref": "#/$defs/layer"
        },
        {
          "properties": {
            "digest": {
              "const": "sha256:3989ea4278ace56c0a91cbcb77670f1ac5acf3101bff7f09d0de88666d4f26f1"
            },
            "compressed_bytes": {
              "const": 173450458
            },
            "purpose": {
              "const": "tools_and_conversion"
            },
            "packet_filename": {
              "const": "3989ea4278ace56c0a91cbcb77670f1ac5acf3101bff7f09d0de88666d4f26f1.tar.gz"
            }
          }
        }
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "compressed_bytes",
        "media_type",
        "purpose",
        "packet_filename"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/hash"
        },
        "compressed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "media_type": {
          "const": "application/vnd.oci.image.layer.v1.tar+gzip"
        },
        "purpose": {
          "enum": [
            "native_libraries",
            "tools_and_conversion"
          ]
        },
        "packet_filename": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}\\.tar\\.gz$"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "llama_cpp_version",
        "compiler",
        "cuda",
        "generator",
        "configuration",
        "flags"
      ],
      "properties": {
        "llama_cpp_version": {
          "const": "b10156"
        },
        "compiler": {
          "const": {
            "id": "GNU",
            "version": "14.2.0"
          }
        },
        "cuda": {
          "const": {
            "enabled": true,
            "version": "12.8.1"
          }
        },
        "generator": {
          "const": "Unix Makefiles"
        },
        "configuration": {
          "const": "Release"
        },
        "flags": {
          "const": [
            "-DGGML_NATIVE=OFF",
            "-DGGML_CUDA=ON",
            "-DGGML_BACKEND_DL=ON",
            "-DGGML_CPU_ALL_VARIANTS=ON",
            "-DLLAMA_BUILD_TESTS=OFF",
            "-DCMAKE_EXE_LINKER_FLAGS=-Wl,--allow-shlib-undefined"
          ]
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "requirements_sha256",
        "wheels"
      ],
      "properties": {
        "mode": {
          "const": "offline_no_index_require_hashes"
        },
        "requirements_sha256": {
          "$ref": "#/$defs/hash"
        },
        "wheels": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "filename",
              "bytes",
              "sha256",
              "requirement"
            ],
            "properties": {
              "filename": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+\\.whl$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "requirement": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+==[A-Za-z0-9_.-]+$"
              }
            }
          }
        }
      }
    },
    "cost_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_cost_evidence_sha256",
        "actual_cost_as_of_utc",
        "actual_campaign_cost_usd",
        "unknown_cost_reservation_usd",
        "accounted_campaign_cost_usd",
        "accounted_campaign_job_ids",
        "accounted_campaign_job_ids_sha256",
        "budget_scope",
        "remaining_credit_authorization_usd",
        "remaining_credit_authorization_sha256",
        "toolchain_flavor",
        "toolchain_hourly_rate_usd",
        "toolchain_timeout_minutes",
        "toolchain_maximum_cost_usd",
        "quantization_reserved_cost_usd",
        "post_authorization_actual_spend_usd",
        "new_toolchain_and_quantization_reservation_usd",
        "maximum_authorized_new_spend_usd",
        "remaining_credit_after_reservations_usd",
        "strictly_below_remaining_credit_authorization"
      ],
      "properties": {
        "actual_cost_evidence_sha256": {
          "$ref": "#/$defs/hash"
        },
        "actual_cost_as_of_utc": {
          "type": "string",
          "format": "date-time"
        },
        "actual_campaign_cost_usd": {
          "$ref": "#/$defs/usd"
        },
        "unknown_cost_reservation_usd": {
          "$ref": "#/$defs/usd"
        },
        "accounted_campaign_cost_usd": {
          "$ref": "#/$defs/usd"
        },
        "accounted_campaign_job_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{24}$"
          }
        },
        "accounted_campaign_job_ids_sha256": {
          "$ref": "#/$defs/hash"
        },
        "budget_scope": {
          "const": "user_reported_remaining_hf_credits"
        },
        "remaining_credit_authorization_usd": {
          "const": "5.500"
        },
        "remaining_credit_authorization_sha256": {
          "const": "sha256:ea566717d68b8372a4c5f39c6279e24efa36f906c1dfe06c048339bd6ae86c0d"
        },
        "toolchain_flavor": {
          "const": "cpu-basic"
        },
        "toolchain_hourly_rate_usd": {
          "const": "0.010"
        },
        "toolchain_timeout_minutes": {
          "const": 20
        },
        "toolchain_maximum_cost_usd": {
          "const": "0.003333"
        },
        "quantization_reserved_cost_usd": {
          "const": "3.800"
        },
        "post_authorization_actual_spend_usd": {
          "$ref": "#/$defs/usd"
        },
        "new_toolchain_and_quantization_reservation_usd": {
          "$ref": "#/$defs/usd"
        },
        "maximum_authorized_new_spend_usd": {
          "$ref": "#/$defs/usd"
        },
        "remaining_credit_after_reservations_usd": {
          "$ref": "#/$defs/usd"
        },
        "strictly_below_remaining_credit_authorization": {
          "const": true
        }
      }
    }
  }
}
