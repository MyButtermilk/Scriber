{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scriber.local/contracts/git-handoff-v1.schema.json",
  "title": "Scriber read-only Git handoff preparation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "policy",
    "inventory",
    "credential_scan",
    "readiness",
    "commit_groups",
    "pull_request_draft",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "detached",
        "head_sha",
        "upstream",
        "remotes",
        "scope",
        "status_porcelain_v1_sha256"
      ],
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "detached": {
          "type": "boolean"
        },
        "head_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "upstream": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/upstream"
            }
          ]
        },
        "remotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/remote"
          }
        },
        "scope": {
          "$ref": "#/$defs/path"
        },
        "status_porcelain_v1_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "include_repository_policy_files",
        "max_text_file_bytes",
        "max_sample_file_bytes",
        "max_total_included_bytes"
      ],
      "properties": {
        "mode": {
          "const": "read_only_fail_closed_v1"
        },
        "include_repository_policy_files": {
          "type": "boolean"
        },
        "max_text_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_sample_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_included_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status_entry_count",
        "scoped_entry_count",
        "tracked_index_count",
        "tracked_index_bytes",
        "tracked_index_listing_sha256",
        "tracked_index",
        "forbidden_tracked_index_count",
        "forbidden_tracked_index",
        "included_count",
        "included_bytes",
        "excluded_count",
        "out_of_scope_count",
        "included",
        "excluded",
        "out_of_scope"
      ],
      "properties": {
        "status_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "scoped_entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "tracked_index_count": {
          "type": "integer",
          "minimum": 0
        },
        "tracked_index_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "tracked_index_listing_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "tracked_index": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tracked_file"
          }
        },
        "forbidden_tracked_index_count": {
          "type": "integer",
          "minimum": 0
        },
        "forbidden_tracked_index": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/forbidden_tracked_file"
          }
        },
        "included_count": {
          "type": "integer",
          "minimum": 0
        },
        "included_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_count": {
          "type": "integer",
          "minimum": 0
        },
        "out_of_scope_count": {
          "type": "integer",
          "minimum": 0
        },
        "included": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/included_file"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/excluded_file"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/status_entry"
          }
        }
      }
    },
    "credential_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "finding_count",
        "findings"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "finding_count": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/credential_finding"
          }
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_safe_to_stage",
        "current_index_safe_to_commit",
        "current_head_safe_to_push",
        "safe_to_create_draft_pr",
        "blocker_codes"
      ],
      "properties": {
        "inventory_safe_to_stage": {
          "type": "boolean"
        },
        "current_index_safe_to_commit": {
          "type": "boolean"
        },
        "current_head_safe_to_push": {
          "type": "boolean"
        },
        "safe_to_create_draft_pr": {
          "const": false
        },
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "commit_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commit_group"
      }
    },
    "pull_request_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "complete",
        "missing_evidence_sections",
        "evidence_sources",
        "body",
        "mutation_performed"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "complete": {
          "type": "boolean"
        },
        "missing_evidence_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "objective",
              "data_pipeline",
              "agent_roles",
              "training",
              "metrics",
              "risks",
              "hf_artifacts",
              "final_status"
            ]
          }
        },
        "evidence_sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/evidence_source"
          }
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "mutation_performed": {
          "const": false
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "report_body_sha256"
      ],
      "properties": {
        "canonicalization": {
          "const": "utf8-json-sort-v1"
        },
        "report_body_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "remote",
        "branch"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fetch_url",
        "push_url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fetch_url": {
          "type": "string",
          "minLength": 1
        },
        "push_url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "worktree"
      ],
      "properties": {
        "index": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        },
        "worktree": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "absent",
            "deleted",
            "gitlink",
            "non_regular",
            "present",
            "symlink"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "git_mode": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        },
        "git_object": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        }
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "worktree"
      ],
      "properties": {
        "index": {
          "$ref": "#/$defs/snapshot"
        },
        "worktree": {
          "$ref": "#/$defs/snapshot"
        }
      }
    },
    "status_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "original_path": {
          "$ref": "#/$defs/path"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "included_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "snapshots",
        "category"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "original_path": {
          "$ref": "#/$defs/path"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "snapshots": {
          "$ref": "#/$defs/snapshots"
        },
        "category": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "excluded_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "snapshots",
        "reason_codes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "original_path": {
          "$ref": "#/$defs/path"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "snapshots": {
          "$ref": "#/$defs/snapshots"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tracked_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "snapshot",
        "category"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "category": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "forbidden_tracked_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "snapshot",
        "reason_codes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "credential_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location",
        "path",
        "rule"
      ],
      "properties": {
        "location": {
          "enum": [
            "evidence",
            "index",
            "remote",
            "worktree"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "commit_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "suggested_message",
        "paths"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "suggested_message": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "pointer"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "pointer": {
          "type": "string",
          "pattern": "^(?:|/.*)$"
        }
      }
    }
  }
}
